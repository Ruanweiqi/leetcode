#include<iostream>
using namespace std;
//定义线性链式表
typedef struct LNode {
	int data;
	struct LNode* next;
}LinkNode;
//头插法
void CreateListF(LinkNode*& L, int arr[], int n) {
	LinkNode* s;
	L = (LinkNode*)malloc(sizeof(LinkNode));
	L->next = NULL;
	for (int i = 0; i < n; i++) {
		s = (LinkNode*)malloc(sizeof(LinkNode));
		s->data = arr[i];
		s->next = L->next;
		L->next = s;
	}
}
//尾插法
void CreateListR(LinkNode*& L, int arr[], int n) {
	LinkNode* s,*r;
	L = (LinkNode*)malloc(sizeof(LinkNode));
	r = L;
	for (int i = 0; i < n; i++) {
		s = (LinkNode*)malloc(sizeof(LinkNode));
		s->data = arr[i];
		r->next = s;
		r = s;
	}
	r->next = NULL;
}