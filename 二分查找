class Solution {
public:
    int search(vector<int>& nums, int target) {
        int n=nums.size();
        int left;
        int right;
        int result=-1;
        left=0;
        right=n-1;
        int middle=(left+right)/2;
        while(left<=right){
            if(nums[middle]<target){
                left=middle+1;
            }
            else if(nums[middle]>target){
                right=middle-1;
            }
            else if(nums[middle]==target){
                result=middle;
                break;
            }
             middle=(left+right)/2;
           
            
        }
        return result;

    }

};