#include <iostream>
using namespace std;

typedef struct LNode {
	char data;
	struct LNode *next;
} LinkNode;

// 初始化：创建头结点
void InitLNode(LinkNode* &L) {
	L = (LNode *)malloc(sizeof(LNode));
	L->next = NULL;
}

// 尾插法建立单链表
void CreateLNode(LinkNode* &L, char arr[], int n) {
	LNode *p = L;
	for (int i = 0; i < n; i++) {
		LNode *s = (LNode *)malloc(sizeof(LNode));
		s->data = arr[i];
		s->next = NULL;
		p->next = s;
		p = s;
	}
}

// 判断元素e是否在链表L中
bool isExist(LinkNode *L, char e) {  
	LNode *p = L->next;
	while (p != NULL) {
		if (p->data == e)
			return true;
		p = p->next;
	}
	return false;
}

