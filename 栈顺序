#include<iostream>
#define Maxsize 100
using namespace std;
//栈的顺序结构定义
typedef struct {
	int data[Maxsize];
	int top;
}SqStack;
//初始化
void InitSqStack(SqStack*& S) {
	S = (SqStack*)malloc(sizeof(SqStack));
	S->top = -1;
}
//销毁
void DestoryStack(SqStack*& S) {
	free(S);
}
//判断是否为空
bool EmptySqtack(SqStack*& S) {
	return(S->top == -1);
}
//进栈
bool Push(SqStack*& S, int e) {
	if (S->top == Maxsize - 1)
		return false;
	else {
		S->data[S->top] = e;
		S->top++;
		return true;
	}
}
//出栈
bool Pop(SqStack*& S, int& e) {
	if (S->top == -1) {
		return false;
	}
	else {
		e = S->data[S->top];
		S->top--;
		return true;
	}
}
//取顶元素
bool GetTop(SqStack*& S, int& e) {
	if (S->top == -1)
		return false;
	else {
		e = S->data[S->top];
		return true;
	}
}